{
  "name": "unifi-protect-monitor",
  "version": "1.9.3",
  "description": "Client UniFi Protect - Fix Codec Misti e UI Completa",
  "author": "Iotatau",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir",
    "test": "electron test/smoke.js",
    "test:avvio": "node test/avvio.js"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.iotatau.unifi-protect-monitor",
    "copyright": "Copyright © 2026 Iotatau",
    "asar": true,
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "password.html",
      "password.js",
      "settings.html",
      "settings.js",
      "splash.html",
      "wallpaper.html",
      "wallpaper.js",
      "logo.png",
      "wallpaper.png",
      "icona.ico",
      "icona1.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icona.ico"
    },
    "nsis": {
      "artifactName": "UniFi_Monitor_${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniFi Protect Monitor",
      "installerIcon": "icona.ico",
      "uninstallerIcon": "icona.ico"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
